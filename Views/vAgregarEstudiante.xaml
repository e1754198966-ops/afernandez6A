<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="afernandez6A.Views.vAgregarEstudiante"
             Title="Agregar Estudiante">

    <VerticalStackLayout Spacing="15" Padding="20">
        <Label Text="Nuevo Estudiante" 
               FontSize="20" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <Label Text="Nombre:" />
        <Entry x:Name="txtNombre" Placeholder="Ingrese el nombre" />

        <Label Text="Apellido:" />
        <Entry x:Name="txtApellido" Placeholder="Ingrese el apellido" />

        <Label Text="Edad:" />
        <Entry x:Name="txtEdad" Placeholder="Ingrese la edad" Keyboard="Numeric" />

        <Button x:Name="btnAgregar" 
                Text="Guardar" 
                BackgroundColor="Blue" 
                TextColor="White" 
                Clicked="btnAgregar_Clicked" />

        <Button x:Name="btnCancelar" 
                Text="Cancelar" 
                BackgroundColor="Gray" 
                TextColor="White" 
                Clicked="btnCancelar_Clicked" />
    </VerticalStackLayout>
</ContentPage>